{{ define "content" }}
<form method="post" action="/reset-password" class="flex flex-col gap-5">
    <input type="hidden" name="token" value="{{ .Token }}">
    <input type="hidden" name="next" value="{{ .Next }}">
    <label class="as-field">New password <input class="as-input" name="new_password" type="password" required autofocus autocomplete="new-password"></label>
    <button type="submit" class="as-button w-full">Set password and sign in</button>
</form>
<p class="as-hint">This signs out every other browser.</p>
{{ end }}
