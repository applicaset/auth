{{ define "content" }}
<form method="post" action="/password" class="flex flex-col gap-5">
    <input type="hidden" name="next" value="{{ .Next }}">
    {{ if .Account.HasPassword }}
    <label class="as-field">Current password <input class="as-input" name="current_password" type="password" required autofocus autocomplete="current-password"></label>
    {{ else if not .Account.Reauthenticated }}
    <p class="as-alert variant-info">Your account has no password yet. <a href="/login?reauth&amp;next=/password">Sign in again</a> first, so we know it is you.</p>
    {{ end }}
    <label class="as-field">New password <input class="as-input" name="new_password" type="password" required autocomplete="new-password"></label>
    <button type="submit" class="as-button w-full">{{ if .Account.HasPassword }}Change password{{ else }}Set password{{ end }}</button>
</form>
<p class="as-hint">Changing your password signs out every other browser.</p>
{{ end }}
