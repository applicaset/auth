{{ define "content" }}
<form method="post" action="/password" class="flex flex-col gap-5">
    <label class="field">Current password <input class="input" name="current_password" type="password" required autofocus autocomplete="current-password"></label>
    <label class="field">New password <input class="input" name="new_password" type="password" required autocomplete="new-password"></label>
    <button type="submit" class="btn w-full">Change password</button>
</form>
<p class="hint">Changing your password signs out every other browser.</p>
{{ end }}
